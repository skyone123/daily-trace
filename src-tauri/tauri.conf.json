{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Trace",
  "version": "0.1.0",
  "identifier": "com.dailytrace.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Daily Trace",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NkM1MEQwNzdEOEExQUQKUldTdG9kaDMwRkJzRnQ4dFBoM1JJWEwrTTVpMUJRUVhHdjRxbnllYk4wZkdlZyt0L25GWTU4UTQK",
      "endpoints": [
        "https://github.com/skyone123/daily-trace/releases/latest/download/latest.json"
      ]
    }
  }
}
